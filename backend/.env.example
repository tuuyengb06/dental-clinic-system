# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite is the default for local development. To opt into SQL Server:
# DMS_DB_ENGINE=mssql
# DMS_DB_NAME=dental_clinic_db
# DMS_DB_HOST=localhost
# DMS_DB_PORT=1433
# DMS_DB_DRIVER=ODBC Driver 17 for SQL Server
# DMS_DB_TRUSTED_CONNECTION=yes

# CORS Config (Cho phép React/Vite kết nối)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173